# Store all text files with LF line endings in the repository, so Windows
# computers and the Linux GitHub Actions runner never fight over line endings.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Fonts and icons are binary: never touch their bytes
*.woff2 binary
*.ico binary
